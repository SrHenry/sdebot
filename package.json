{
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "postinstall": "run-script-os",
    "postinstall:win32": "if not exist .env copy .env.example .env else echo \"[INFO]: '.env' already exists!\"",
    "postinstall:darwin:linux": "[ ! -f .env ] && cp .env.example .env || echo \"[INFO]: '.env' already exists!\"",
    "prebuild": "run-script-os",
    "prebuild:win32": "tsc --project tsconfig.build.json; if ($?) tsc-alias -p tsconfig.build.json",
    "prebuild:linux": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build": "webpack -c webpack.config.js",
    "prebuild:clean": "rimraf dist",
    "build:clean": "yarn run build",
    "test": "jest",
    "test:inspect": "node --inspect node_modules/.bin/jest",
    "test:coverage": "jest --coverage",
    "circular-dependencies": "madge --ts-config tsconfig.json --circular --extensions ts src",
    "circular-dependencies:graph": "madge --ts-config tsconfig.json --circular --extensions ts --image .madge/circular-dependencies.graph.svg src",
    "cd": "yarn run circular-dependencies",
    "cd:graph": "yarn run circular-dependencies"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "comment-json": "^4.4.1",
    "dotenv": "^17.2.3",
    "jest": "^30.2.0",
    "madge": "^8.0.0",
    "rimraf": "^6.1.2",
    "run-script-os": "^1.1.6",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@srhenry/type-utils": "^0.6.0"
  },
  "overrides": {
    "micromatch": "^4.0.8"
  },
  "resolutions": {
    "micromatch": "^4.0.8"
  }
}
